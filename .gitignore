node_modules/
.env
.env.local
.env.*.local
dist/
# @keystone/shared has no monorepo build orchestration (no turborepo/prepare-hook wiring, and
# pnpm's build-script approval gate makes an automatic postinstall build unreliable — see the
# better-sqlite3 native-build gotcha in DECISIONS.md). Committing its small compiled dist/ is
# the zero-setup-friction choice for anyone cloning; rebuild by hand (`pnpm --filter
# @keystone/shared build`) after editing packages/shared/src/*.ts.
!packages/shared/dist/
build/
.next/
out/

# Foundry
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/*/*/run-*.json
!packages/contracts/broadcast/*/*/run-latest.json

# Indexer local DB
packages/indexer/*.sqlite
packages/indexer/*.sqlite-journal
packages/indexer/data/

# Engine bot restart-safety state (local, per-machine)
packages/engine/state/

# Logs
*.log
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/mcp.json
.idea/
