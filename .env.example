# ─────────────────────────────────────────────────────────────────────────────
# Keystone — environment configuration
# Copy to .env and fill in. Never commit .env. Testnets only — never mainnet keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Chain RPCs ---
# Source: https://docs.arc.io/arc/references/connect-to-arc.md
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.network
ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# --- Wallets (testnet only — five distinct EOAs per PRD §Phase 0 step 5) ---
# Fund each at https://faucet.circle.com with Arc Testnet USDC + EURC,
# and Base Sepolia USDC. Faucets are rate-limited; farm daily.
DEPLOYER_PRIVATE_KEY=
MM_BOT_A_PRIVATE_KEY=
MM_BOT_B_PRIVATE_KEY=
RESERVE_KEEPER_PRIVATE_KEY=
DEMO_USER_PRIVATE_KEY=

# --- Circle App Kit ---
# Register a kit key at https://console.circle.com
# Packages: @circle-fin/app-kit + @circle-fin/adapter-viem-v2 (npm, confirmed Phase 0)
CIRCLE_APP_KIT_KEY=KIT_KEY:c0d778bcec74553c5ba45e27cfd1e255:a16454d08ad43fa28750e43c1b057783

# --- Deployed contract addresses (populated by packages/contracts deploy scripts) ---
# Mirrors packages/shared/addresses.json — kept here too for scripts that read env directly.
PAIR_REGISTRY_ADDRESS=
BALANCE_MANAGER_ADDRESS=
KEYSTONE_BOOK_ADDRESS=
FEE_COLLECTOR_ADDRESS=
KEYSTONE_RESERVE_ADDRESS=
MOCK_ORACLE_ADDRESS=
MOCK_USDT_ADDRESS=

# --- Arcscan verification (once Etherscan-compatible API confirmed, Phase 1) ---
ARCSCAN_API_KEY=

# --- Indexer ---
INDEXER_SQLITE_PATH=./packages/indexer/keystone.sqlite
INDEXER_PORT=8787

# --- Web app ---
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_INDEXER_URL=http://localhost:8787
NEXT_PUBLIC_ARCSCAN_URL=https://testnet.arcscan.app
NEXT_PUBLIC_PAIR_REGISTRY_ADDRESS=
NEXT_PUBLIC_BALANCE_MANAGER_ADDRESS=
NEXT_PUBLIC_KEYSTONE_BOOK_ADDRESS=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=
NEXT_PUBLIC_KEYSTONE_RESERVE_ADDRESS=
NEXT_PUBLIC_MOCK_ORACLE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=

# --- Name resolution (S2) ---
# InfinityName contract verified in Phase 0: 0x76a816EFa69e3183972ff7a231F5C8d7b065d9De
# ArcNS (https://arcnames.xyz/) kept as documented fallback per PRD open question #5.
NEXT_PUBLIC_INFINITY_NAME_ADDRESS=0x76a816EFa69e3183972ff7a231F5C8d7b065d9De
