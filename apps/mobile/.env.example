# Create a Privy app at https://dashboard.privy.io (App settings > API Keys) and enable
# "Passkey" as a login method (Login Methods tab). Copy this file to .env and fill in:
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# The indexer's REST API — defaults to localhost, override for a device/simulator that can't
# reach your machine's localhost (use your LAN IP, or the deployed indexer URL).
EXPO_PUBLIC_INDEXER_URL=http://localhost:8787

# Must match a domain that serves /.well-known/apple-app-site-association (iOS) and
# /.well-known/assetlinks.json (Android) — see README.md "Passkey domain setup".
EXPO_PUBLIC_PASSKEY_RELYING_PARTY=https://keystone-web-nine.vercel.app
